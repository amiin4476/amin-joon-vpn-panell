
# Database
DATABASE_URL=sqlite:///./aminjoon.db

# Security
# Generate a unique Fernet key for each installation.
NODE_CREDENTIALS_KEY=GENERATE_YOUR_OWN_FERNET_KEY

# Generate a random secret with at least 32 bytes.
# Never use this example value in production.
APP_SECRET_KEY=GENERATE_YOUR_OWN_RANDOM_SECRET_KEY

# API
APP_ENV=development
APP_DEBUG=false

# CORS
# Separate multiple origins with commas.
# Supports domains, IPv4 and IPv6 addresses.
# Examples:
# CORS_ORIGINS=https://panel.example.com
# CORS_ORIGINS=http://192.168.1.100:5173
# CORS_ORIGINS=https://panel.example.com,http://192.168.1.100:5173
CORS_ORIGINS=http://localhost:5173
