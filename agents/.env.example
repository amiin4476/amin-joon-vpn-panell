
# AMIN JOON Node Agent

# A unique secret with at least 32 characters
AGENT_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Name of this VPN server
NODE_NAME=Germany-Node-01

# Public domain, IPv4, or IPv6 address
# Examples:
# AGENT_DOMAIN=agent.example.com
# AGENT_DOMAIN=203.0.113.10
# AGENT_DOMAIN=[2001:db8::10]
AGENT_DOMAIN=agent.example.com

# Optional email for ACME certificate registration
ACME_EMAIL=admin@example.com
